{
  "name": "mjml-api",
  "version": "1.0.0",
  "description": "MJML API Conversion",
  "repository": "https://github.com/ViBiOh/mjml-api",
  "main": "src/index.mjs",
  "scripts": {
    "format": "./node_modules/prettier/bin/prettier.cjs --write \"{src,test}/**/*.mjs\"",
    "style": "./node_modules/eslint/bin/eslint.js --fix \"{src,test}/**/*.mjs\"",
    "start": "node src/index.mjs",
    "test": "OTEL_SDK_DISABLED=true node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "mjml",
    "api",
    "conversion"
  ],
  "author": "ViBiOh",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.300.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-runtime-node": "0.37.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mjml": "5.4.1",
    "winston": "3.19.0",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=25"
  }
}
